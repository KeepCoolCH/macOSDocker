    "Alle lokalen Volumes als TAR-Archive. Container werden währenddessen gestoppt. Archive können einzeln importiert werden; Container und Netzwerke sind nicht enthalten.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle lokalen Volumes als TAR-Archive. Container werden währenddessen gestoppt. Archive können einzeln importiert werden; Container und Netzwerke sind nicht enthalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All local volumes as TAR archives. Containers are stopped during the backup. Archives can be imported individually; containers and networks are not included."
          }
        }
      }
    },
