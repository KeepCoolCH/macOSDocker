    "Anführungszeichen, mehrzeilige Befehle mit \\ sowie $HOME, $PWD und $(pwd) sind möglich. Für -it bitte im Terminal starten.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anführungszeichen, mehrzeilige Befehle mit \\ sowie $HOME, $PWD und $(pwd) sind möglich. Für -it bitte im Terminal starten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quotes, multiline commands using \\ and $HOME, $PWD or $(pwd) are supported. For -it, launch in Terminal."
