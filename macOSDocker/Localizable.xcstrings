{
  "sourceLanguage": "de",
  "strings": {
    "\n\nVerwendende Container:\n": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nVerwendende Container:\n"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nContainers using this volume:\n"
          }
        }
      }
    },
    "\nAutomatische Freigabe aktivieren oder diese Ordner unter Mac-Freigaben hinzufügen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\nAutomatische Freigabe aktivieren oder diese Ordner unter Mac-Freigaben hinzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\nEnable automatic sharing or add these folders under Mac Shares."
          }
        }
      }
    },
    "\nCLI-Ausführung abgebrochen. Bereits erstellte Container bleiben in der Containerliste sichtbar.\n": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\nCLI-Ausführung abgebrochen. Bereits erstellte Container bleiben in der Containerliste sichtbar.\n"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\nCLI execution canceled. Containers already created remain visible in the container list.\n"
          }
        }
      }
    },
    "\n[Ausgabe gekürzt]\n": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\n[Ausgabe gekürzt]\n"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n[Output truncated]\n"
          }
        }
      }
    },
    "%@ liegt in der schreibgeschützten Freigabe %@. Bind mit :ro verwenden oder die Freigaberechte bei gestoppter VM ändern.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ liegt in der schreibgeschützten Freigabe %@. Bind mit :ro verwenden oder die Freigaberechte bei gestoppter VM ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is inside the read-only share %@. Use a :ro bind or change the share permissions while the VM is stopped."
          }
        }
      }
    },
    "%@ umfasst eine bereits freigegebene Unterstruktur. Bitte Freigaben bei gestoppter VM zusammenfassen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ umfasst eine bereits freigegebene Unterstruktur. Bitte Freigaben bei gestoppter VM zusammenfassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ contains an existing shared folder. Combine the shares while the VM is stopped."
          }
        }
      }
    },
    "%lld/%@ · intern": {
      "localizations": {
