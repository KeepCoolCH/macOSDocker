          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an unused address in the adapter’s subnet. A gateway is required for IPv4 destinations outside that subnet. Leave DNS empty to keep the DNS servers obtained at startup."
